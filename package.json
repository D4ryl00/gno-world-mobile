{
  "name": "gno-world",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.26",
    "@gnolang/gnonative": "^5.3.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "bech32": "^2.0.0",
    "expo": "~57.0.31",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@connectrpc/connect-node": "^2.2.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "e2e": "bash scripts/e2e.sh",
    "gnodev": "bash scripts/gnodev.sh",
    "devchain:update": "node scripts/devchain-update.mjs",
    "fake-offchain": "node --experimental-strip-types --no-warnings scripts/fake-offchain/main.mjs",
    "e2e:chat": "jest -c jest.e2e.config.js --runInBand e2e/fake-offchain e2e/chat",
    "e2e:pair": "jest -c jest.e2e.config.js --runInBand e2e/pair",
    "fake-browser": "node --experimental-strip-types --no-warnings scripts/fake-offchain/browser.mjs",
    "demo": "npm --prefix demo run all",
    "demo:build": "bash demo/tools/build.sh",
    "demo:capture": "npm --prefix demo run capture --",
    "demo:voice": "npm --prefix demo run voice",
    "demo:render": "npm --prefix demo run render",
    "demo:check": "npm --prefix demo run check",
    "demo:stage": "npm --prefix demo run stage"
  },
  "private": true,
  "license": "Apache-2.0",
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/\\.e2e/",
      "/demo/"
    ]
  }
}
